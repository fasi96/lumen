#!/bin/bash
# Lumen's floating camera bubble.
#   lumen-cam [args]          show it (replacing one that's already up); --demo for the demo routine
#   lumen-cam stop            close it
#   lumen-cam ping            exit 0 if it's running and answering
#   lumen-cam hide | show     fade it out of the way (clicks pass through) / back in
#   lumen-cam center          centre the (still) camera view on you, once
#   lumen-cam place X Y W H   make sure it's inside this area (global coords): moves monitor/corner if needed
here=$(dirname "$(readlink -f "$0")")/../cam
# Its pid file and control socket live in the private per-user runtime folder, never /tmp.
[[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR ]] || { echo "lumen-cam: XDG_RUNTIME_DIR isn't set" >&2; exit 1; }
pidf="$XDG_RUNTIME_DIR/lumen-cam.pid"
sock="$XDG_RUNTIME_DIR/lumen-cam.sock"

send() {
  # -I: run from any folder without importing modules that happen to sit in it.
  python3 -I - "$sock" "$*" <<'PY'
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(1)
try:
    s.connect(sys.argv[1])
    s.sendall(sys.argv[2].encode())
    sys.exit(0 if s.recv(16).startswith(b"ok") else 1)
except OSError:
    sys.exit(1)
PY
}
# Only ever stops the bubble: the pid must still belong to a lumen_cam.py process.
stop() {
  local pid
  pid=$(cat "$pidf" 2>/dev/null)
  if [[ $pid =~ ^[0-9]+$ ]] && tr '\0' ' ' 2>/dev/null <"/proc/$pid/cmdline" | grep -q "lumen_cam.py"; then
    kill "$pid" 2>/dev/null
  fi
  # `uv run` hands over to python: the bubble itself may have a different pid.
  send quit >/dev/null 2>&1
  rm -f "$pidf"
}

case $1 in
stop) stop; exit 0 ;;
ping) send ping; exit $? ;;
hide | show | center) send "$1"; exit $? ;;
place) shift; send place "$@"; exit $? ;;
esac

stop
echo $$ >"$pidf"
# Layer shell has to be loaded before Wayland. The camera AI's environment is made by
# `lumen setup bubble` from hash-locked lists (cam/requirements.lock, build tools included).
venv="${LUMEN_CAM_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/lumen/cam-venv}"
if [[ -x $venv/bin/python ]]; then
  LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so exec "$venv/bin/python" "$here/lumen_cam.py" "$@"
fi
# Set up before 1.3.0: the environment uv made from the script's lock, offline only, so
# nothing new is ever fetched or built here (if it's gone: lumen setup bubble).
LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so exec uv run -q --locked --offline --project "$here" --script "$here/lumen_cam.py" "$@"
